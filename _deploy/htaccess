Options -Indexes
DirectoryIndex index.html

<IfModule mod_rewrite.c>
RewriteEngine On

# Let AutoSSL / Let's Encrypt validation through untouched.
RewriteRule ^\.well-known/ - [L]

# www and alias domains (mulesigames.com.tr, mulesigames.xyz) -> mulesigames.com.
# deploy.py writes {SCHEME} as https once mulesigames.com has a valid certificate, http before that.
RewriteCond %{HTTP_HOST} !^mulesigames\.com$ [NC]
RewriteCond %{HTTP_HOST} mulesigames\. [NC]
RewriteRule ^ {SCHEME}://mulesigames.com%{REQUEST_URI} [R=301,L]

# Old URLs that stores and shipped builds still use.
RewriteRule ^privacy\.html$ https://mulesigames.com/dontdrop/privacy/ [R=301,L]

# BEGIN force-https (deploy.py drops this block until the certificate is valid)
# HTTPS ends at Cloudflare (SSL mode "Flexible"): the origin only sees plain http, so check the
# proxy header. Natro's port 443 serves cPanel's default page for this domain, so "Full" won't work.
RewriteCond %{HTTP:X-Forwarded-Proto} =http
RewriteRule ^ https://mulesigames.com%{REQUEST_URI} [R=301,L]
# END force-https
</IfModule>

<IfModule mod_expires.c>
ExpiresActive On
ExpiresByType image/webp "access plus 30 days"
ExpiresByType image/png "access plus 30 days"
ExpiresByType font/woff2 "access plus 1 year"
ExpiresByType text/css "access plus 1 day"
ExpiresByType application/javascript "access plus 1 day"
ExpiresByType text/html "access plus 10 minutes"
</IfModule>
